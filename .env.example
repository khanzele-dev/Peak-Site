# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env.local в git не попадает (см. .gitignore) — секреты храните только там.
# На хостинге (Vercel/VPS) эти же переменные задаются в настройках окружения.

# --- База данных ---
# Локально поднимается через `docker compose up -d` (см. docker-compose.yml).
# Порт 5433, а не стандартный 5432 — чтобы не конфликтовать с локально
# установленным PostgreSQL, если он у вас уже есть.
DATABASE_URL="postgresql://dragonvpn:dragonvpn@localhost:5433/dragonvpn?schema=public"

# --- Сессии/JWT ---
# Случайная строка не короче 32 символов. Сгенерировать: openssl rand -base64 48
# На проде — свой уникальный секрет, не тот, что в локальной разработке.
AUTH_JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars-long"

# --- Публичный адрес сайта (куда ЮKassa возвращает после оплаты) ---
# Обязателен на проде: без него создание платежей отключается.
APP_URL="https://your-domain.example"

# --- Remnawave ---
# Базовый URL панели и API-токен. Если панель позволяет — выдайте токен только
# с правами на пользователей и ноды, не полный админский.
REMNAWAVE_API_URL="https://panel.example.com"
REMNAWAVE_API_TOKEN=""
# UUID squad'а (см. GET /api/internal-squads в панели), в который попадают
# новые платные пользователи — без него у купивших не будет доступа к серверам.
REMNAWAVE_SQUAD_UUID=""

# --- ЮKassa (можно оставить пустым — покупка будет отключена, сайт не упадёт) ---
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Вебхуки принимаются только с IP-адресов ЮKassa. "off" — только для локальной
# отладки через туннель (ngrok и т.п.), на проде не выключать.
YOOKASSA_WEBHOOK_IP_CHECK=""

# --- Прокси перед сайтом (для корректного IP клиента в rate limit) ---
# Сколько доверенных прокси добавляют адрес в X-Forwarded-For:
#   Vercel или один nginx/Caddy → 1 (по умолчанию); Cloudflare → nginx → 2.
# На своём сервере nginx должен передавать: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# и сам Next не должен быть доступен напрямую, в обход nginx.
TRUSTED_PROXY_HOPS="1"

# --- Первый администратор (используется в prisma/seed.ts) ---
SEED_ADMIN_PHONE="+79990000000"
SEED_ADMIN_PASSWORD="change-me-strong-password"

# --- Rate limit (защита входа, регистрации, оплаты и API от подбора/спама) ---
# На Vercel ОБЯЗАТЕЛЬНО: без Redis лимит хранится в памяти каждого serverless-
# инстанса отдельно и по сути не работает. Подключите Upstash for Redis через
# Vercel Marketplace — переменные пропишутся сами.
# На своём сервере с одним процессом `next start` in-memory лимит работает,
# но сбрасывается при перезапуске. Локально можно оставить пустым.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
